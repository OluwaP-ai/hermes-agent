+def resolve_pre_memory_write(
+    *,
+    action: str,
+    target: str,
+    content: str,
+    session_id: str = "",
+    messages: Optional[List[Dict[str, Any]]] = None,
+    metadata: Optional[Dict[str, Any]] = None,
+) -> tuple[bool, str]:
+    """Return a fail-closed policy decision for an external memory write.
+
+    No registered policy preserves upstream behavior. Once any policy is
+    registered, at least one explicit ``{"action": "allow"}`` is required
+    and any ``{"action": "block"}`` wins. Callback failures are converted to
+    block directives by :meth:`PluginManager.invoke_hook`.
+    """
+    if not has_hook("pre_memory_write"):
+        return True, ""
+
+    results = invoke_hook(
+        "pre_memory_write",
+        action=action,
+        target=target,
+        content=content,
+        session_id=session_id,
+        messages=list(messages or []),
+        metadata=dict(metadata or {}),
+    )
+    allowed = False
+    for result in results:
+        if not isinstance(result, dict):
+            continue
+        directive = result.get("action")
+        if directive == "block":
+            reason = result.get("reason")
+            return False, reason if isinstance(reason, str) else "memory policy blocked write"
+        if directive == "allow":
+            allowed = True
+    if not allowed:
+        return False, "memory policy returned no explicit allow decision"
+    return True, ""
+
+
 _thread_tool_whitelist = threading.local()
 
 
diff --git a/tests/webbook/test_memory_policy_hook.py b/tests/webbook/test_memory_policy_hook.py
new file mode 100644
index 0000000..3e3992c
--- /dev/null
+++ b/tests/webbook/test_memory_policy_hook.py
@@ -0,0 +1,216 @@
+"""Behavioral proof for the generic pre-memory-release policy hook."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from agent.memory_manager import MemoryManager
+from agent.memory_provider import MemoryProvider
+import hermes_cli.plugins as plugins
+
+
+class _RecordingProvider(MemoryProvider):
+    def __init__(self) -> None:
+        self.synced: list[dict[str, Any]] = []
+        self.mirrored: list[dict[str, Any]] = []
+        self.shutdown_called = False
+
+    @property
+    def name(self) -> str:
+        return "external"
+
+    def is_available(self) -> bool:
+        return True
+
+    def initialize(self, session_id: str, **kwargs: Any) -> None:
+        return None
+
+    def system_prompt_block(self) -> str:
+        return "stable provider prompt"
+
+    def sync_turn(
+        self,
+        user_content: str,
+        assistant_content: str,
+        *,
+        session_id: str = "",
+        messages: list[dict[str, Any]] | None = None,
+    ) -> None:
+        self.synced.append(
+            {
+                "user_content": user_content,
+                "assistant_content": assistant_content,
+                "session_id": session_id,
+                "messages": messages,
+            }
+        )
+
+    def get_tool_schemas(self) -> list[dict[str, Any]]:
+        return [
+            {
+                "name": "stable_memory_tool",
+                "description": "A stable test tool",
+                "parameters": {"type": "object", "properties": {}},
+            }
+        ]
+
+    def handle_tool_call(
+        self, tool_name: str, args: dict[str, Any], **kwargs: Any
+    ) -> str:
+        return "{}"
+
+    def on_memory_write(
+        self,
+        action: str,
+        target: str,
+        content: str,
+        metadata: dict[str, Any] | None = None,
+    ) -> None:
+        self.mirrored.append(
+            {
+                "action": action,
+                "target": target,
+                "content": content,
+                "metadata": metadata,
+            }
+        )
+
+    def shutdown(self) -> None:
+        self.shutdown_called = True
+
+
+@pytest.fixture
+def policy_manager(monkeypatch: pytest.MonkeyPatch) -> plugins.PluginManager:
+    manager = plugins.PluginManager()
+    monkeypatch.setattr(plugins, "_plugin_manager", manager)
+    return manager
+
+
+def _memory_manager() -> tuple[MemoryManager, _RecordingProvider]:
+    manager = MemoryManager()
+    provider = _RecordingProvider()
+    manager.add_provider(provider)
+    return manager, provider
+
+
+def _register(
+    manager: plugins.PluginManager,
+    *callbacks: Any,
+) -> None:
+    manager._hooks.setdefault("pre_memory_write", []).extend(callbacks)
+
+
+def _exercise_both_write_paths(
+    manager: MemoryManager,
+) -> None:
+    manager.sync_all(
+        "candidate user content",
+        "candidate assistant content",
+        session_id="session-1",
+        messages=[{"role": "user", "content": "candidate user content"}],
+    )
+    manager.on_memory_write(
+        "add",
+        "memory",
+        "candidate fact",
+        metadata={"source": "test"},
+    )
+
+
+def test_no_registered_policy_preserves_compatibility(
+    policy_manager: plugins.PluginManager,
+) -> None:
+    manager, provider = _memory_manager()
+
+    _exercise_both_write_paths(manager)
+
+    assert manager.flush_pending(timeout=5) is True
+    assert len(provider.synced) == 1
+    assert len(provider.mirrored) == 1
+    manager.shutdown_all()
+
+
+def test_explicit_allow_proceeds(
+    policy_manager: plugins.PluginManager,
+) -> None:
+    observed: list[dict[str, Any]] = []
+
+    def allow(**candidate: Any) -> dict[str, str]:
+        observed.append(candidate)
+        return {"action": "allow"}
+
+    _register(policy_manager, allow)
+    manager, provider = _memory_manager()
+
+    _exercise_both_write_paths(manager)
+
+    assert manager.flush_pending(timeout=5) is True
+    assert len(provider.synced) == 1
+    assert len(provider.mirrored) == 1
+    assert [item["action"] for item in observed] == ["sync_turn", "add"]
+    assert observed[0]["target"] == "external_memory_providers"
+    assert observed[1]["metadata"] == {"source": "test"}
+    manager.shutdown_all()
+
+
+@pytest.mark.parametrize(
+    "callback",
+    [
+        pytest.param(
+            lambda **_candidate: {"action": "block", "reason": "test policy"},
+            id="explicit-block",
+        ),
+        pytest.param(
+            lambda **_candidate: {"action": "unexpected"},
+            id="malformed-result",
+        ),
+        pytest.param(lambda **_candidate: None, id="no-decision"),
+    ],
+)
+def test_non_allow_decisions_block_before_provider_receipt(
+    policy_manager: plugins.PluginManager,
+    callback: Any,
+) -> None:
+    _register(policy_manager, callback)
+    manager, provider = _memory_manager()
+
+    _exercise_both_write_paths(manager)
+
+    assert manager._sync_executor is None
+    assert manager.flush_pending(timeout=0.1) is True
+    assert provider.synced == []
+    assert provider.mirrored == []
+
+
+def test_callback_exception_blocks_even_with_an_allowing_policy(
+    policy_manager: plugins.PluginManager,
+) -> None:
+    def allow(**_candidate: Any) -> dict[str, str]:
+        return {"action": "allow"}
+
+    def fail(**_candidate: Any) -> None:
+        raise RuntimeError("policy unavailable")
+
+    _register(policy_manager, allow, fail)
+    manager, provider = _memory_manager()
+
+    _exercise_both_write_paths(manager)
+
+    assert manager._sync_executor is None
+    assert provider.synced == []
+    assert provider.mirrored == []
+
+
+def test_policy_registration_does_not_change_prompt_or_toolset(
+    policy_manager: plugins.PluginManager,
+) -> None:
+    manager, _provider = _memory_manager()
+    prompt_before = manager.build_system_prompt()
+    tools_before = manager.get_all_tool_schemas()
+
+    _register(policy_manager, lambda **_candidate: {"action": "allow"})
+
+    assert manager.build_system_prompt() == prompt_before
+    assert manager.get_all_tool_schemas() == tools_before
